# Copy this file to `.env` and fill in the values. Do not commit `.env`.
# The web process (Next.js) and the worker process (src/worker/main.ts) both
# read `.env` from the project root. A variable that is set in the shell wins.

# --- Necessary ---------------------------------------------------------------

# The API key for the Ollama cloud API. The model judges each item and writes
# the deeper analysis. Without it, the sources are checked but no story shows.
OLLAMA_API_KEY=

# --- Optional: X (Twitter) ---------------------------------------------------

# The Bearer Token of your X API app. Without it, X sources show "Needs token".
# X bills each post that the app reads.
X_BEARER_TOKEN=
# Hard stop for X post reads in one UTC day. Default: 300.
X_MAX_POSTS_PER_DAY=

# --- Optional: model settings ------------------------------------------------

# Model names of the Ollama cloud. The defaults are in docs/specification.md (section 20).
OLLAMA_MODEL_JUDGE=
OLLAMA_MODEL_JUDGE_FALLBACK=
OLLAMA_MODEL_ANALYSIS=
OLLAMA_MODEL_ANALYSIS_FALLBACK=
# Default: https://ollama.com
OLLAMA_HOST=
# Hard stop for model calls in one UTC day. Default: 1500.
LLM_MAX_CALLS_PER_DAY=
# Hard stop for web searches (saved web search sources) in one UTC day. Default: 50.
WEB_SEARCH_MAX_PER_DAY=

# --- Optional: other sources -------------------------------------------------

# A GitHub token. Only GitHub discussions need it; it also raises the rate limit.
GITHUB_TOKEN=
# A Reddit app (type "script" or "web app"). Only necessary when Reddit refuses
# requests without a login from your server.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# The dedicated mailbox for newsletters (IMAP over TLS). The app only reads it.
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=

# --- Optional: app -----------------------------------------------------------

# The path of the SQLite file that the web process and the worker share.
# A relative path starts at the project root. Default: ./data/app.db
DATABASE_PATH=

# The port of the web process. Default: 4400.
# The npm scripts read PORT from the shell only (example: PORT=4500 npm run dev).
# A PORT value in `.env` does not change the port.
PORT=
