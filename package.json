{
  "name": "industry-intel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 concurrently --kill-others --names web,worker --prefix-colors cyan,magenta \"next dev --port ${PORT:-4400}\" \"tsx watch --clear-screen=false src/worker/main.ts\"",
    "dev:web": "NEXT_TELEMETRY_DISABLED=1 next dev --port ${PORT:-4400}",
    "dev:worker": "tsx watch --clear-screen=false src/worker/main.ts",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 concurrently --kill-others --names web,worker --prefix-colors cyan,magenta \"next start --hostname ${WEB_HOST:-0.0.0.0} --port ${PORT:-4400}\" \"NODE_ENV=production tsx src/worker/main.ts\"",
    "start:web": "NEXT_TELEMETRY_DISABLED=1 next start --hostname ${WEB_HOST:-0.0.0.0} --port ${PORT:-4400}",
    "start:worker": "NODE_ENV=production tsx src/worker/main.ts",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "imapflow": "^2.12.1",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.77.0",
    "mailparser": "^3.14.5",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
